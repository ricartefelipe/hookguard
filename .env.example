HOOKGUARD_DOMAIN=hooks.example.com
HOOKGUARD_DB_NAME=hookguard
HOOKGUARD_DB_USER=hookguard
# Obrigatório em produção: defina uma senha forte (o Compose recusa subir sem ela).
HOOKGUARD_DB_PASSWORD=
HOOKGUARD_DB_URL=jdbc:postgresql://localhost:5432/hookguard
HOOKGUARD_CORS_ORIGINS=http://localhost:3000
HOOKGUARD_APP_BASE_URL=http://localhost:3000
HOOKGUARD_API_BASE_URL=http://localhost:8080
# Só para desenvolvimento local (aceita destinos http/loopback/rede privada). Em produção mantenha false.
HOOKGUARD_DELIVERY_ALLOW_HTTP=false
# Só para desenvolvimento/demo: devolve o link de login na resposta. Em produção mantenha false.
HOOKGUARD_EXPOSE_MAGIC_LINK=false
HOOKGUARD_TRUST_FORWARDED_HOST=false
HOOKGUARD_INGEST_RATE_LIMIT=120
HOOKGUARD_MAX_BODY_BYTES=1048576
HOOKGUARD_DEDUPE_TTL_HOURS=24
HOOKGUARD_FROM_EMAIL=noreply@hookguard.local
HOOKGUARD_SMTP_HOST=localhost
HOOKGUARD_SMTP_PORT=1025
HOOKGUARD_SMTP_USER=
HOOKGUARD_SMTP_PASSWORD=
HOOKGUARD_SMTP_AUTH=false
HOOKGUARD_SMTP_STARTTLS=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_METER_EVENT_NAME=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
