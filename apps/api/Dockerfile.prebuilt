# eclipse-temurin:21-jre
FROM eclipse-temurin@sha256:0b99b3376fbb50dbf9c0af8535fdd5b8eb0d3fdfc8b1e4967f383b6919f6901a
RUN rm -f /usr/bin/pebble \
    && apt-get update && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 hookguard \
    && useradd --system --uid 10001 --gid hookguard --no-create-home --shell /usr/sbin/nologin hookguard
WORKDIR /app
COPY target/hookguard-api-*.jar /app/app.jar
USER hookguard
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
