HOOKGUARD_DB_NAME=hookguard
HOOKGUARD_DB_USER=hookguard
HOOKGUARD_DB_PASSWORD=troque-esta-senha-forte
HOOKGUARD_PUBLIC_ORIGIN=https://placeholder.trycloudflare.com
# Mantenha false. true devolve o link de login (e o token) na resposta da API a qualquer chamador: só para
# demonstração local isolada, nunca numa instância acessível pela internet. Configure SMTP para o login real.
HOOKGUARD_EXPOSE_MAGIC_LINK=false
HOOKGUARD_FROM_EMAIL=noreply@hookguard.local
HOOKGUARD_SMTP_HOST=
HOOKGUARD_SMTP_PORT=587
HOOKGUARD_SMTP_USER=
HOOKGUARD_SMTP_PASSWORD=
HOOKGUARD_SMTP_AUTH=false
HOOKGUARD_SMTP_STARTTLS=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_METER_EVENT_NAME=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
