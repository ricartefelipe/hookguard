HOOKGUARD_DB_NAME=hookguard
HOOKGUARD_DB_USER=hookguard
HOOKGUARD_DB_PASSWORD=troque-esta-senha-forte
HOOKGUARD_PUBLIC_ORIGIN=https://placeholder.trycloudflare.com
# Mantenha false. true devolve o link de login (e o token) na resposta da API a quem enviar o código de acesso
# da demonstração: só para ambiente de demonstração sem dados reais. Configure SMTP para o login real.
HOOKGUARD_EXPOSE_MAGIC_LINK=false
# Código de acesso da demonstração. Só vale junto com HOOKGUARD_EXPOSE_MAGIC_LINK=true; vazio = o link nunca
# volta na resposta. É um código público de demonstração, não um segredo: quem o conhece entra com qualquer
# e-mail. O docker-compose.oracle.yml não repassa esta variável.
# HOOKGUARD_DEMO_ACCESS_CODE=
HOOKGUARD_FROM_EMAIL=noreply@hookguard.local
HOOKGUARD_SMTP_HOST=
HOOKGUARD_SMTP_PORT=587
HOOKGUARD_SMTP_USER=
HOOKGUARD_SMTP_PASSWORD=
HOOKGUARD_SMTP_AUTH=false
HOOKGUARD_SMTP_STARTTLS=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_METER_EVENT_NAME=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
